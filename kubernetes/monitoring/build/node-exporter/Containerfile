# monitoring-node node-exporter — upstream v1.12.1(6044da78) 소스 + golang.org/x/crypto v0.56.0 빌드. 입력·출처·절차는 BUILD.md.
# 모든 base 이미지는 digest로 고정한다. src/의 go.mod·go.sum은 build.sh 3단계에서 x/crypto만 올린 것이다.
FROM docker.io/library/golang@sha256:0f063af2d465d8dcae54cce04278ada488b96f77b42449c8d071e47d016cc65a AS build
WORKDIR /src
COPY src/ ./
# go.sum 검증(-mod=readonly), 다른 Go toolchain 자동 다운로드 금지(GOTOOLCHAIN=local), 정적 바이너리.
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly
RUN go version \
 && go build -trimpath -tags netgo,osusergo \
      -ldflags "-X github.com/prometheus/common/version.Version=1.12.1-fds.1 -X github.com/prometheus/common/version.Revision=6044da783597cc3b57aef7580ddcdcff58a4ee99 -X github.com/prometheus/common/version.Branch=v1.12.1" \
      -o /out/node_exporter . \
 && go version -m /out/node_exporter \
 && /out/node_exporter --version

FROM cgr.dev/chainguard/static@sha256:c5fed92d0fda728930795cafb61192d8abc9e2f606b22996b212e0169f1d42e6
COPY --from=build /out/node_exporter /bin/node_exporter
# upstream 공식 이미지와 같은 nobody(65534). DaemonSet securityContext(privileged false, drop ALL, readOnlyRootFilesystem)는 그대로 쓴다.
USER 65534:65534
EXPOSE 9100
ENTRYPOINT ["/bin/node_exporter"]
